# 1. Buat folder "hasil" di root repo
mkdir -p hasil

# 2. Salin file hasil build kernel ke folder hasil
cp out/arch/arm64/boot/Image.gz-dtb hasil/

# 3. Tambahkan folder hasil dan file DTS yang diedit ke staging git
git add hasil/ arch/arm64/boot/dts/mediatek/a02/mt6739-a02_common.dtsi arch/arm64/boot/dts/mediatek/mt6739.dts

# 4. Commit perubahan
git commit -m "build: inject samsung a02 dtb nodes and add build artifact"

# 5. Push ke repository GitHub
git push origin HEAD
